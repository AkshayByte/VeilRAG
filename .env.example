# LLM provider: "hosted" (OpenAI-compatible API) or "ollama" (local Ollama)
LLM_PROVIDER=ollama

# Hosted API settings (used when LLM_PROVIDER=hosted)
# OPENAI_API_BASE=https://api.openai.com/v1
# OPENAI_API_KEY=your-key-here
# LLM_MODEL=gpt-4o-mini

# Ollama settings (used when LLM_PROVIDER=ollama)
OLLAMA_HOST=http://localhost:11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b
# OLLAMA_JUDGE_MODEL=gemma3:4b    # defaults to OLLAMA_MODEL
OLLAMA_NUM_CTX=8192
OLLAMA_SEED=42
OLLAMA_TIMEOUT_S=300
OLLAMA_NUM_PREDICT_SHORT=64
OLLAMA_NUM_PREDICT_ANSWER=400

# ChromaDB
CHROMA_PERSIST_DIR=data/chroma

# Server
API_HOST=0.0.0.0
API_PORT=8000
